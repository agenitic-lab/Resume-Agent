\begin{document}

\begin{center}
    {\Huge \scshape << contact.name >>} \\ \vspace{1pt}
    <%% if contact.location %%><< contact.location >> \\ \vspace{1pt}<%% endif %%>
    \small 
    <%% if contact.phone %%>\href{tel:<< contact.phone >>}{ \raisebox{-0.1\height}\faPhone\ \underline{<< contact.phone >>} ~}<%% endif %%> 
    <%% if contact.email %%>\href{mailto:<< contact.email >>}{\raisebox{-0.2\height}\faEnvelope\  \underline{<< contact.email >>}} ~<%% endif %%>
    <%% if contact.linkedin %%>\href{<< contact.linkedin >>}{\raisebox{-0.2\height}\faLinkedin\ \underline{<< contact.linkedin_label or 'LinkedIn' >>}}  ~<%% endif %%>
    <%% if contact.github %%>\href{<< contact.github >>}{\raisebox{-0.2\height}\faGithub\ \underline{<< contact.github_label or 'GitHub' >>}} ~<%% endif %%>
    <%% if contact.portfolio %%>\href{<< contact.portfolio >>}{\raisebox{-0.2\height}\faGlobe\ \underline{<< contact.portfolio_label or 'Portfolio' >>}}<%% endif %%>
    \vspace{-8pt}
\end{center}

<%% if contact.summary %%>
\section{SUMMARY}
    \small{<< contact.summary >>}
    \vspace{-5pt}
<%% endif %%>

<%% if education|length > 0 %%>
\section{EDUCATION}
  \resumeSubHeadingListStart
  <%% for edu in education %%>
    \resumeSubheading
      {<< edu.school >>}{<< edu.start_year >> -- << edu.end_year or 'Present' >>}
      {<< edu.degree >>}{}
  <%% endfor %%>
  \resumeSubHeadingListEnd
<%% endif %%>

<%% if projects|length > 0 %%>
\section{PROJECTS}
    \vspace{-5pt}
    \resumeSubHeadingListStart
    <%% for proj in projects %%>
       \resumeProjectHeading
          {\textbf{\large{\underline{<< proj.title >>}}} <%% if proj.tools %%>$|$ \large{\underline{<< proj.tools >>}}<%% endif %%>}{}
          <%% if proj.role %%>
          \vspace{-4pt}
          \begin{itemize}[leftmargin=0.15in, label={}]
              \small{\item{\textit{\normalsize{<< proj.role >>}}}}
          \end{itemize}
          \vspace{-7pt}
          <%% endif %%>
          <%% if proj.details %%>
          \resumeItemListStart
            <%% for detail in proj.details %%>
            <%% if detail.strip() %%>
            \resumeItem{\normalsize{<< detail >>}}
            <%% endif %%>
            <%% endfor %%>
          \resumeItemListEnd 
          <%% endif %%>
          \vspace{-13pt}
    <%% endfor %%>
    \resumeSubHeadingListEnd
\vspace{-12pt}
<%% endif %%>

<%% if experience|length > 0 %%>
\section{EXPERIENCE}
  \resumeSubHeadingListStart
  <%% for exp in experience %%>
    \resumeSubheading
      {<< exp.company >>}{<< exp.start_date >> -- << exp.end_date or 'Present' >>} 
      {\underline{<< exp.title >>}}{}
      <%% if exp.details %%>
      \resumeItemListStart
        <%% for detail in exp.details %%>
        <%% if detail.strip() %%>
        \resumeItem{\normalsize{<< detail >>}}
        <%% endif %%>
        <%% endfor %%>
      \resumeItemListEnd  
      <%% endif %%>
  <%% endfor %%>
  \resumeSubHeadingListEnd
\vspace{-12pt}
<%% endif %%>

<%% if custom_sections|length > 0 %%>
<%% for sec in custom_sections %%>
\section{\textls[100]{<< (sec.title or sec.type) | upper >>}}
\begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
        <%% if sec.content %%>\normalsize{<< sec.content >>}<%% endif %%>
    }}
\end{itemize}
\vspace{-12pt}
<%% endfor %%>
<%% endif %%>

<%% if skills|length > 0 %%>
\section{SKILLS}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
     \textbf{\normalsize{Skills:}}{ \normalsize{<< skills | join(', ') >>}} \\
    }}
 \end{itemize}
 \vspace{-15pt}
<%% endif %%>

\end{document}
