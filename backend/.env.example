# copy this to .env and fill in your values
# don't commit .env to git!

# Database - get connection string from Supabase dashboard
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/resume_agent

# Auth secrets - generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings for secure token storage
# COOKIE_DOMAIN: Leave empty for development, set to your domain for production (e.g., ".resiko.app")
COOKIE_DOMAIN=
# COOKIE_SECURE: Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# COOKIE_SAMESITE: "lax" for standard protection, "strict" for maximum protection, "none" for cross-site (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# Encryption for storing API keys securely
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Google OAuth (optional) - get from Google Cloud Console
# Follow instructions in GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# CORS - allowed frontend origins
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example (add your deployed frontend domain):
# ALLOWED_ORIGINS=https://resiko.app,https://www.resiko.app
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|\[::1\]|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$

# Groq API - get from console.groq.com/keys (users can provide their own too)
GROQ_API_KEY=your-groq-api-key-here

# which models to use for each step
JOB_REQUIREMENTS_MODEL=llama-3.3-70b-versatile
RESUME_ANALYSIS_MODEL=llama-3.3-70b-versatile
PLANNING_MODEL=llama-3.3-70b-versatile
MODIFICATION_MODEL=llama-3.3-70b-versatile

# llm generation params
DEFAULT_TEMPERATURE=0.2
MAX_TOKENS=4000

# agent behavior tuning
MAX_ITERATIONS=3
TARGET_SCORE=75.0
MIN_ITERATION_GAIN=1.0

# fit thresholds - below 0.25 = reject, 0.25-0.45 = partial fit, 0.45+ = good
FIT_THRESHOLD_POOR=0.25
FIT_THRESHOLD_PARTIAL=0.45

# latex service
LATEX_COMPILE_URL=https://latex.ytotech.com/builds/sync
LATEX_TIMEOUT=30

# app settings
DEBUG=false
LOG_LEVEL=INFO
# For production deployment, use these settings:
#
# DATABASE_URL=postgresql://user:strong_password@prod-db.example.com:5432/resume_agent
# JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
# ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# COOKIE_DOMAIN=.yourdomain.com
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# DEBUG=false
# LOG_LEVEL=WARNING
# LATEX_TIMEOUT=10  # Reduce timeout for better UX

# --- Zoho SMTP & Support System ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=support@resiko.app
SMTP_PASSWORD=
SUPPORT_EMAIL=support@resiko.app
