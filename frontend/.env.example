# Vite dev server proxy target (used by vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:8000

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Production: set VITE_API_URL to your API origin (e.g. https://backend.resiko.app).
# VITE_API_BASE_URL is accepted as a fallback if VITE_API_URL is unset.
# Leave both empty in dev to use the Vite proxy (same-origin cookies).
# VITE_API_URL=https://backend.example.com
# VITE_API_BASE_URL=https://backend.example.com
