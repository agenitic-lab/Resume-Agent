# Vite dev server proxy target (used by vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:8000

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Optional: set these for production where there's no Vite proxy
# Leave unset/empty in dev to use the Vite proxy for same-origin cookies
# VITE_API_URL=https://api.example.com
# VITE_API_BASE_URL=https://api.example.com
